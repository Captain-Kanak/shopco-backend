model Order {
    id              String    @id @default(uuid(7))
    orderNumber     String    @db.VarChar(255)
    recipientName   String    @db.VarChar(255)
    shippingAddress String    @db.Text
    phone           String    @db.VarChar(15)
    totalAmount     Decimal   @db.Decimal(10, 2)
    discountAmount  Decimal   @default(0.00) @db.Decimal(10, 2)
    shippingCost    Decimal   @default(0.00) @db.Decimal(10, 2)
    paidAt          DateTime?
    shippedAt       DateTime?
    deliveredAt     DateTime?
    cancelledAt     DateTime?

    orderStatus   OrderStatus   @default(PENDING)
    paymentStatus PaymentStatus @default(UNPAID)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    payment    Payment?
    orderItems OrderItem[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@unique([orderNumber])
    @@index([userId])
    @@index([deletedAt])
    @@map("order")
}

model OrderItem {
    id           String  @id @default(uuid(7))
    sku          String  @db.VarChar(255)
    productTitle String  @db.VarChar(255)
    unitPrice    Decimal @db.Decimal(10, 2)
    quantity     Int     @default(1)

    orderId String
    order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

    variantId String
    variant   ProductVariant @relation(fields: [variantId], references: [id])

    orderItemAttributes OrderItemAttribute[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([orderId])
    @@index([variantId])
    @@index([deletedAt])
    @@map("order_item")
}

model OrderItemAttribute {
    id    String @id @default(uuid(7))
    name  String @db.VarChar(100)
    value String @db.VarChar(255)

    orderItemId String
    orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([orderItemId, name])
    @@index([orderItemId])
    @@map("order_item_attribute")
}
